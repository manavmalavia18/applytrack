# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Session signing secret (16+ characters)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: protect /api/cron/follow-ups (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-cron-secret

# Draft form answers (preferred): Anthropic API key from https://console.anthropic.com/
# Claude.ai Pro subscription ≠ API access — API is billed separately.
# Set the same var in Vercel → Project → Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Optional fallback: Vercel AI Gateway (billed via Vercel; needs a card on file).
# On Vercel this may work via OIDC; locally set a key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=

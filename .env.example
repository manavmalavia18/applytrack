# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Session signing secret (16+ characters)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: protect /api/cron/follow-ups (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-cron-secret

# AI Gateway (for Draft form answers). On Vercel this often works via OIDC;
# locally set a gateway key from https://vercel.com/ai-gateway
# AI_GATEWAY_API_KEY=
